#
# Inner-tunnel virtual server for PEAP.
# The REST module supplies NT-Password and VLAN policy; post-auth mirrors
# VLAN attributes to the outer reply and records the auth event.
#
server inner-tunnel {

    listen {
        ipaddr = 127.0.0.1
        port = 18120
        type = auth
    }

    authorize {
        filter_username

        update control {
            &Proxy-To-Realm := LOCAL
        }

        chap
        mschap
        suffix

        # The eap module MUST run in authorize so it can detect the EAP-Message
        # attribute and set Auth-Type := EAP.  Without this, FreeRADIUS fails
        # with "No Auth-Type found" even though the authenticate section has
        # a bare `eap` entry.  ok = return skips subsequent modules when EAP
        # is already fully handled (e.g. inner method already accepted).
        eap {
            ok = return
        }

        update control {
            &Tmp-String-0 := "peap"
        }

        rest
        # Authorize hook returns control:Tmp-String-1 on HTTP 200 for unknown users.
        if (&control:Tmp-String-1 == "unknown-username" || \
            &control:Tmp-String-1 == "account-expired" || \
            &control:Tmp-String-1 == "account-inactive") {
            update reply {
                &Class := "%{control:Tmp-String-1}"
            }
            update session-state {
                &Class := "%{control:Tmp-String-1}"
            }
            update outer.session-state {
                &Class := "%{control:Tmp-String-1}"
            }
            reject
        }

        expiration
        logintime
    }

    authenticate {
        # Use the lowercase name "mschap" — the rlm_mschap module registers
        # its Auth-Type as "mschap" (lowercase) at instantiation time.
        # eap_mschapv2 looks up Auth-Type by the numeric value for "MSCHAP"
        # (case-insensitive, so it finds "mschap").  The rbtree key must match,
        # so this section must be named "mschap" to match that key.
        # "Auth-Type MS-CHAP" compiles to a DIFFERENT numeric key and is
        # never found by the eap_mschapv2 → process_authenticate call.
        Auth-Type mschap {
            mschap
        }

        eap
    }

    session {
        sql
    }

    post-auth {
        # Inner-tunnel requests often lack Calling-Station-Id. Copy it from
        # the outer PEAP request so radpostauth and the REST hook see the MAC.
        update request {
            &Calling-Station-Id := "%{outer.request:Calling-Station-Id}"
            &Called-Station-Id := "%{outer.request:Called-Station-Id}"
        }

        update outer.reply {
            Tunnel-Type += &reply:Tunnel-Type
            Tunnel-Medium-Type += &reply:Tunnel-Medium-Type
            Tunnel-Private-Group-ID := &reply:Tunnel-Private-Group-ID
        }

        rest
        # API returns control:Tmp-String-1 for device-policy rejects.
        if (&control:Tmp-String-1 == "unregistered-device" || \
            &control:Tmp-String-1 == "device-pending" || \
            &control:Tmp-String-1 == "device-rejected" || \
            &control:Tmp-String-1 == "device-blocked" || \
            &control:Tmp-String-1 == "unknown-username" || \
            &control:Tmp-String-1 == "account-expired" || \
            &control:Tmp-String-1 == "account-inactive") {
            update outer.session-state {
                &Class := "%{control:Tmp-String-1}"
            }
            reject
        }
        if (rest == fail || rest == reject || rest == notfound || rest == invalid) {
            if (!&control:Tmp-String-1) {
                update control {
                    &Tmp-String-1 := "unknown-username"
                }
            }
            update reply {
                &Class := "%{control:Tmp-String-1}"
            }
            update outer.session-state {
                &Class := "%{control:Tmp-String-1}"
            }
            reject
        }

        sql

        Post-Auth-Type REJECT {
            attr_filter.access_reject

            update request {
                &Calling-Station-Id := "%{outer.request:Calling-Station-Id}"
                &Called-Station-Id := "%{outer.request:Called-Station-Id}"
            }

            if (!&control:Tmp-String-1) {
                if (&session-state:Class) {
                    update control {
                        &Tmp-String-1 := "%{session-state:Class}"
                    }
                }
                else {
                    if (&reply:Class) {
                        update control {
                            &Tmp-String-1 := "%{reply:Class}"
                        }
                    }
                    else {
                        update control {
                            &Tmp-String-1 := "wrong-password"
                        }
                    }
                }
            }
            update reply {
                &Class := "%{control:Tmp-String-1}"
            }
            update outer.session-state {
                &Module-Failure-Message := &request:Module-Failure-Message
                &Class := "%{control:Tmp-String-1}"
            }

            sql
        }
    }

    pre-proxy {
    }

    post-proxy {
        eap
    }
}
